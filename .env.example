# Copy to .env to override. Every value has a working default in compose.

# --- Database ---
POSTGRES_USER=outreach
POSTGRES_PASSWORD=outreach
POSTGRES_DB=outreach
POSTGRES_PORT=5433

# --- Ports ---
API_PORT=8000
WEB_PORT=3000
MAILPIT_UI_PORT=8025

# --- Mail ---
# console = log the email and deliver nothing (default, safe).
# smtp    = deliver to the SMTP host below; compose points this at Mailpit,
#           so mail is captured at http://localhost:8025 and never leaves.
MAIL_DRIVER=console
MAIL_FROM=outreach@example.com

# --- Sending guardrails ---
DAILY_SEND_CAP=200
WORKER_INTERVAL_SECONDS=15

# --- AI generation ---
# Required for the email composer. Without it, generate returns a clear error
# and the rest of the CRM keeps working.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# --- Login ---
# The single account that can sign in. Both must be set: an empty value locks
# the gate shut for everyone rather than opening it, so a missing .env fails
# closed. Change these before exposing the app beyond localhost.
AUTH_USERNAME=outreach
AUTH_PASSWORD=change-me

# --- App ---
CORS_ORIGINS=http://localhost:3000
SEED_ON_START=true

# --- Gmail sync ---
# Read the mailbox over the Gmail API instead of IMAP. Get these by running:
#   python backend/scripts/gmail_authorize.py
# The refresh token opens a real mailbox -- keep it in .env only. This repo
# is public.
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
GMAIL_ADDRESS=

# Gmail App Password for SENDING (smtp.gmail.com:587). Separate from OAuth
# above, which is read-only. Requires 2-Step Verification on the account:
#   https://myaccount.google.com/apppasswords
# 16 characters, no spaces.
SMTP_APP_PASSWORD=
