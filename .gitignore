# ---- Secrets ----
# .env holds ANTHROPIC_API_KEY. Never commit it; .env.example is the template.
.env
.env.*
!.env.example
*.pem
*.key
secrets.json

# Google OAuth client files. The downloaded JSON carries the client secret,
# and the token file carries a refresh token that reads the whole mailbox.
client_secret*.json
*client_secret*.json
backend/secrets/
*credentials*.json
gmail_token.json

# ---- Python ----
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
*.egg-info/
.venv/
venv/
env/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# ---- Node / Next.js ----
node_modules/
.next/
out/
build/
.turbo/
*.tsbuildinfo
next-env.d.ts

# ---- Package manager logs ----
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# ---- Prospect data ----
# Enrichment exports contain personal contact data (names, work emails,
# phone numbers). Keep them out of the repo. Commit only sample/ files that
# have been deliberately anonymized.
*.csv
!sample*.csv
!**/sample/*.csv

# ---- Editors / OS ----
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db
desktop.ini

# ---- Local tooling ----
.claude/

# Android signing material. The keystore IS the app's identity -- publishing it
# would let anyone ship an update that Android accepts as genuine, and the repo
# is public.
android/*.keystore
android/*.jks
android/twa-manifest.json
android/build/
android/app/build/
android/.gradle/
android/local.properties
android/*.apk
